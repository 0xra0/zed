+#[gpui::test]
+async fn test_title_request_keeps_turn_prefix(cx: &mut TestAppContext) {
+    let ThreadTest {
+        model,
+        fake,
+        thread,
+        ..
+    } = setup(cx, TestModel::Fake).await;
+
+    let summary_model = fake.model("summary");
+    thread.update(cx, |thread, cx| {
+        thread.add_tool(EchoTool);
+        thread.set_summarization_model(Some(summary_model.clone()), cx)
+    });
+
+    let send = thread
+        .update(cx, |thread, cx| {
+            thread.send(ClientUserMessageId::new(), ["Hello"], cx)
+        })
+        .unwrap();
+    cx.run_until_parked();
+    let turn_request = fake.pending_completions_for(&model).pop().unwrap();
+    fake.send_last_text(&model, "Hey!");
+    fake.end_last(&model);
+    cx.run_until_parked();
+
+    // The title request starts with the turn's system prompt and history and
+    // offers the same tools, so a prefix-caching server reuses the turn.
+    let title_request = fake.pending_completions_for(&summary_model).pop().unwrap();
+    assert!(!turn_request.tools.is_empty());
+    assert_eq!(title_request.tools, turn_request.tools);
+    // (`cache` marks each request's own last message, so it is left out.)
+    let text = |messages: &[LanguageModelRequestMessage]| {
+        messages
+            .iter()
+            .map(|message| (message.role, message.string_contents()))
+            .collect::<Vec<_>>()
+    };
+    assert_eq!(
+        text(&title_request.messages[..turn_request.messages.len()]),
+        text(&turn_request.messages)
+    );
+    assert_eq!(
+        title_request.messages.last().unwrap().string_contents(),
+        agent_settings::SUMMARIZE_THREAD_PROMPT
+    );
+
+    fake.send_text(&summary_model, &title_request, "Greeting");
+    fake.end_stream(&summary_model, &title_request);
+    send.collect::<Vec<_>>().await;
+    cx.run_until_parked();
+    thread.read_with(cx, |thread, _| {
+        assert_eq!(thread.title(), Some("Greeting".into()))
+    });
+}
