+    /// The thread-title request. While a turn is running it starts with the
+    /// turn's own system prompt and tools, so a server that reuses prompt
+    /// prefixes reads only the title instruction, and still holds the thread
+    /// for its next turn. With no turn running it is the plain history.
+    fn build_title_request(&self, temperature: Option<f32>, cx: &App) -> LanguageModelRequest {
+        let (available_tools, tools) = self.request_tools(cx);
+        if tools.is_empty() {
+            return build_thread_title_request(&self.id, &self.messages, temperature);
+        }
+        let mut request = LanguageModelRequest {
+            thread_id: Some(self.id.to_string()),
+            intent: Some(CompletionIntent::ThreadSummarization),
+            temperature,
+            messages: self.build_request_messages_until(available_tools, self.messages.len(), cx),
+            tools,
+            ..Default::default()
+        };
+        request.messages.push(LanguageModelRequestMessage {
+            role: Role::User,
+            content: vec![SUMMARIZE_THREAD_PROMPT.into()],
+            cache: false,
+            reasoning_details: None,
+        });
+        request
+    }
